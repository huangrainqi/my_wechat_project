/* pages/login/login.wxss */
.login-container {
  padding: 100rpx 60rpx 0;
  min-height: 100vh;
  background: #000000;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #333333 0%, #555555 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #444444;
}

.logo-icon {
  font-size: 50rpx;
  color: #ffffff;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.welcome-text {
  font-size: 28rpx;
  color: #cccccc;
}

.login-form {
  background: #1a1a1a;
  border-radius: 24rpx;
  padding: 60rpx 50rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  border: 1rpx solid #333333;
}

.form-group {
  margin-bottom: 50rpx;
}

.input-container {
  display: flex;
  align-items: center;
  background: #2d2d2d;
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  border: 2rpx solid #444444;
  transition: all 0.3s;
}

.input-container:focus-within {
  border-color: #667eea;
  background: #333333;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.2);
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
  color: #cccccc;
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  color: #ffffff;
  background: transparent;
}

.form-input::placeholder {
  color: #888888;
}

.password-toggle {
  font-size: 36rpx;
  margin-left: 20rpx;
  padding: 8rpx;
  color: #cccccc;
}

.error-text {
  font-size: 24rpx;
  color: #e74c3c;
  margin-top: 16rpx;
  display: block;
}

.login-btn {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 30rpx;
  transition: all 0.3s;
}

.login-btn:disabled {
  background: #333333;
  color: #666666;
  opacity: 0.6;
}

.login-btn:not([disabled]):active {
  transform: scale(0.98);
  opacity: 0.8;
}