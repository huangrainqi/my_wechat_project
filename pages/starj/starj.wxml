<view class="wrap">
  <!-- 顶部：连接状态 + VIN 选择 -->
  <view class="top-bar">
    <view class="status {{connected?'on':'off'}}">
      <text class="dot">●</text>
      <text>{{connected?'已连接':'未连接'}}</text>
    </view>
    <picker bindchange="onVinPick" value="{{vinIdx}}" range="{{vinList}}" mode="selector">
      <view class="vin-picker">{{vinList[vinIdx]}} ▼</view>
    </picker>
  </view>
  <button class="btn select" bindtap="onSelectVin">
   选择 vin 码：{{vinList[vinIdx]}} ▼
   </button>
  <!-- 日志卡片 -->
  <view class="log-card">
    <view class="log-hd">
      <text class="log-title">Live Log</text>
      <text class="log-count">共 {{logCount}} 条</text>
    </view>
    <scroll-view scroll-y class="log-body">
      <text class="log-txt">{{received}}</text>
    </scroll-view>
  </view>

  <!-- 输入区 -->
  <view class="input-card">
    <input class="input" value="{{pubTopic}}" bindinput="onPubTopic" placeholder="发布 Topic" />
    <textarea class="textarea" value="{{pubMsg}}" bindinput="onPubMsg" placeholder='{"msg":"hello"}' auto-height />
    <button class="btn send" bindtap="doPublish">Publish</button>
    <button class="btn connect" bindtap="doConnect">{{connected?'断开':'Connect'}}</button>
  </view>
</view>