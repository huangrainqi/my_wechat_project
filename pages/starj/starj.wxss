/* 全局可滚动 */page{
  background:#000;                     /* 纯黑 */
  color:#e4e6eb;
  min-height:100vh;
  overflow-y:auto;
  -webkit-overflow-scrolling:touch;
  box-sizing:border-box;
}
.dot.green { color: #32CD32; }   /* 连接绿 */
.dot.red   { color: #FF0000; }   /* 断连红 */

.btn.select {
  width: calc(100vw - 80rpx);
  margin: 0 auto 30rpx;
  height: 68rpx;
  font-size: 28rpx;
  background: linear-gradient(135deg, #3a86ff 0%, #8338ec 100%);
  color: #fff;
  border-radius: 18rpx;
}

.wrap {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.status {
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.status .dot {
  margin-right: 8rpx;
  font-size: 32rpx;
}

.status.on .dot {
  color: #00c853;
}

.status.off .dot {
  color: #ff3d00;
}

.vin-picker {
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .08);
}

/* 日志卡片 */
.log-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .06);
  display: flex;
  flex-direction: column;
}

.log-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.log-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.log-count {
  font-size: 24rpx;
  color: #888;
}

.log-body {
  flex: 1;
  overflow: hidden;
}

/* 让 scroll-view 占满剩余高度 */
.log-txt {
  font-size: 22rpx;
  line-height: 1.0;        /* 原来是 1.5 左右，改成 1.2~1.3 */
  color: #555;
  font-family: var(--mono);
  white-space: pre-wrap;
}

/* 输入卡片 */
.pub-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .06);
}

.input,
.textarea {
  width: 100%;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 80rpx;
}

/* 按钮统一小尺寸 */
.btn {
  width: 100%;
  height: 72rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 16rpx;
  transition: all .2s ease;
}

.btn.send {
  background: linear-gradient(135deg, #00f5d4 0%, #00b3a1 100%);
  color: #000;
}

.btn.connect {
  background: linear-gradient(135deg, #ff007f 0%, #d6006c 100%);
  color: #fff;
}

.btn:active {
  transform: scale(.96);
}