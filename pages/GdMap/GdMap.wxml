<!--pages/GdMap/GdMap.wxml-->
<view class="title">小窗口地图</view>

<!-- 固定小窗口 -->
<view
  class="map-window {{isFull ? 'full' : ''}}"
  style="width:{{winWidth}}rpx;height:{{winHeight}}rpx;"
>
  <map
    id="gaodeMap"
    longitude="{{lng}}"
    latitude="{{lat}}"
    scale="16"
    show-location
    markers="{{markers}}"
    style="width:100%;height:100%;"
  />
</view>

<!-- 控制栏 -->
<view class="btn-bar">
  <button bindtap="toggleFull" type="primary" size="mini">
    {{isFull ? '退出全屏' : '全屏'}}
  </button>
</view>